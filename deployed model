# Constants
num_classes = 16
MODEL_PATH_SEGNET = './models/segnet2.h5'
vertebrae_labels = [1, 2, 3, 4, 5, 6, 7]  # These correspond to the labels for each vertebra
vertebra_titles = ['C2', 'C3', 'C4', 'C5', 'C6', 'C7', 'T1']  # Titles for each vertebra

# Define custom functions
def preprocess_image(image):
    resized_image = cv2.resize(image, (384, 384))
    processed_image = np.array(resized_image) / 255.0
    return processed_image

def predict(image):
    with tf.keras.utils.custom_object_scope({'dice_loss': dice_loss, 'combined_loss': combined_loss ,'mean_iou': mean_iou}):
        segnet_model = tf.keras.models.load_model('./models/segnet2.h5')
    processed_image = preprocess_image(image)
    segnet_prediction = segnet_model.predict(processed_image.reshape(1, 384, 384, 3))
    threshold = 0.1
    binary_predictions = (segnet_prediction > threshold).astype(np.uint8)
    print(binary_predictions)
    segnet_prediction = np.squeeze(binary_predictions, axis=0)  # Remove the batch dimension

    return segnet_prediction

def dice_loss(y_true, y_pred):
    y_true = K.cast(y_true, y_pred.dtype)
    numerator = 2 * K.sum(y_true * y_pred, axis=(1, 2, 3))
    denominator = K.sum(y_true + y_pred, axis=(1, 2, 3))
    dice_per_class = (numerator + K.epsilon()) / (denominator + K.epsilon())
    dice_loss = 1 - K.mean(dice_per_class)
    return dice_loss

def combined_loss(y_true, y_pred):
    dice = dice_loss(y_true, y_pred)
    ce = categorical_crossentropy(y_true, y_pred)
    combined = 0.5 * dice + 0.5 * ce
    return combined

def mean_iou(y_true, y_pred):
    y_pred = K.argmax(y_pred, axis=-1)
    y_pred = K.one_hot(y_pred, num_classes = 16)
    intersection = K.sum(K.cast(y_true * y_pred, 'float'), axis=[1, 2])
    union = K.sum(K.cast(y_true + y_pred, 'float'), axis=[1, 2]) - intersection
    smooth = K.epsilon()
    iou = (intersection + smooth) / (union + smooth)
    mean_iou = K.mean(iou)
    return mean_iou

def find_extents(label_mask):
    if label_mask.ndim == 2:
        active_slices = np.any(label_mask, axis=1)  # Change axis to 0 for vertical extent
    else:
        raise ValueError("Unsupported mask dimensionality: {}".format(label_mask.ndim))
    xs = np.where(active_slices)[0]
    if len(xs) == 0:
        return (0, 0)
    return (np.min(xs), np.max(xs))  # Use min and max of xs for top and bottom extents

def calculate_max_width(label_mask):
    if np.any(label_mask):
        max_width = np.max(np.sum(label_mask, axis=1))
    else:
        max_width = 0
    return max_width

def calculate_sagittal_diameter(binary_mask):
    print(binary_mask.shape)
    pixel_spacing_mm = [0.5, 0.5]  # Assuming pixel spacing mm/pixel
    threshold_width_vertebrae = 14  # Threshold width in millimeters for vertebrae_labels [2, 3, 4, 5, 6, 7]
    threshold_width_vertebra_1 = 17  # Threshold width in millimeters for vertebrae_label 1
    spinal_canal_label = 14
    spinal_cord_label = 15

    spinal_widths = {}
    vertebra_extents = {}
    for i, label in enumerate(vertebrae_labels):
        vertebra_mask = binary_mask[..., label] == 1
        extents = find_extents(vertebra_mask)
        vertebra_extents[vertebra_titles[i]] = extents
        # print(f"Extents for {vertebra_titles[i]}: {extents}")

        top, bottom = find_extents(binary_mask[..., label])

        spinal_canal_section = binary_mask[top:bottom + 1, :, spinal_canal_label] == 1
        spinal_cord_section = binary_mask[top:bottom + 1, :, spinal_cord_label] == 1
        merged_section = np.logical_or(spinal_canal_section, spinal_cord_section)

        max_width = calculate_max_width(merged_section)
        mm_width = max_width * pixel_spacing_mm[0]

        if label in [2, 3, 4, 5, 6, 7]:
            threshold_width = threshold_width_vertebrae
        elif label == 1:
            threshold_width = threshold_width_vertebra_1

        percent_difference = ((mm_width - threshold_width) / threshold_width) * 100
        percent_difference_formatted = "{:.2f}%".format(percent_difference)
        spinal_widths[vertebra_titles[i]] = {'pixels': max_width, 'mm': mm_width, "%compression": percent_difference_formatted}

        if mm_width < threshold_width:
            print(
                f"Narrowing detected at Vertebra {vertebra_titles[i]}: Width = {mm_width:.2f} mm (Threshold = {threshold_width} mm, % Difference = {percent_difference:.2f}%)"
            )
        else:
            print(
                f"No narrowing detected at Vertebra {vertebra_titles[i]}: Width = {mm_width:.2f} mm (Threshold = {threshold_width} mm, % Difference = {percent_difference:.2f}%)"
            )

    return spinal_widths


def overlay_mask_on_image(image, mask):
    cmap = plt.cm.get_cmap('viridis', num_classes)
    custom_cmap = ListedColormap([cmap.colors[i] for i in range(num_classes)])
    fig, ax = plt.subplots(figsize=(8, 8))

    plt.figure(figsize=(8, 8))
    plt.imshow(image)
    plt.title('Segmented Mask Overlay on Image')
    plt.axis('off')

    # Overlay segmentation predictions
    colored_mask = np.zeros_like(mask)
    for class_index in range(num_classes):
        binary_predictions = (mask[..., class_index] > 0.1).astype(np.uint8)
        colored_mask[..., class_index] = binary_predictions * (class_index + 1)
    colored_mask = np.argmax(colored_mask, axis=-1)

    # Plot overlay
    plt.imshow(colored_mask, cmap=custom_cmap, alpha=0.4, interpolation='none')

    # Create legend based on colormap
    legend_patches = [mpatches.Patch(color=cmap.colors[class_index], label=f'Class {class_index}') for class_index in range(num_classes)]
    plt.legend(handles=legend_patches, loc='upper left', bbox_to_anchor=(1, 1), title='Legend')

    output_path = os.path.join("images", f'image_overlay.png')

    # Create legend based on colormap
    legend_patches = [mpatches.Patch(color=cmap.colors[class_index], label=f'Class {class_index}') for class_index in range(num_classes)]
    plt.legend(handles=legend_patches, loc='upper left', bbox_to_anchor=(1, 1), title='Legend')
    plt.savefig(output_path, bbox_inches='tight')
    plt.close(fig)

