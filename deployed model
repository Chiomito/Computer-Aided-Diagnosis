# Load models
@st.cache(allow_output_mutation=True)
def load_model():
    with tf.keras.utils.custom_object_scope({'dice_loss': dice_loss, 'combined_loss': combined_loss ,'mean_iou': mean_iou}):
        segnet_model = tf.keras.models.load_model(MODEL_PATH_SEGNET)
    return segnet_model

# Streamlit app
def main():
    st.title('Cervical Spine MRI Image Segmentation and Computation of Sagittal Diameter')

    uploaded_image = st.file_uploader('Choose an image', type=['jpg', 'png', 'jpeg'])

    if uploaded_image is not None:
        image = np.array(Image.open(uploaded_image))
        segnet_model = load_model()
        segnet_prediction = predict(image)

        # st.write('Final Prediction:', segnet_prediction)

        # Overlay predicted mask on the original image
        overlay_mask_on_image(image, segnet_prediction)
        overlay_mask_single(image, segnet_prediction)

        # Display image overlay
        image = Image.open("./images/image_overlay.png")
        image_mask = Image.open("./images/mask_overlay.png")
        st.image(image, caption='Overlay Image', use_column_width=True)
        st.image(image_mask, caption='Mask Image', use_column_width=True)

        # Compute sagittal diameter
        dimensions = calculate_sagittal_diameter(segnet_prediction)

        st.subheader('Diagnosis Aid: Sagittal Diagnosis and Percentage Compression')
        st.write('Benchmark Sagittal Diameter: C3 - T1 = 14 mm and C2 = 17mm')

        # Display sagittal diameter information in a pandas dataframe
        df = pd.DataFrame(dimensions).T
        df.columns = ['Pixels', 'mm', "% compression"]
        st.write(df)

if __name__ == '__main__':
    main()
